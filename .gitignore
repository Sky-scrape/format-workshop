# ============================================================
# 私有素材：属于别人的稿子和期刊原件，绝不公开
# ============================================================

# 用于训练/实测的真实论文（他人未发表稿件）
训练论文/

# 期刊原件：官方稿约 PDF、已发表论文 PDF。版权归期刊与作者
rules/sources/

# 历史处理结果，可能含用户论文内容
outputs/

# 本地旧的启动脚本（含本机绝对路径）
旧脚本/

# 工作区数据
.workbuddy/

# 含密钥的本地配置（页面里设置后自动生成，见 config/ai.example.json）
config/ai.json

# 编辑器/系统遗留的空文件
shell

# ============================================================
# 期刊规则库：开源仓库只收录 3 本示例
# 完整规则库另行分发，请勿把本机的全部规则集提交上来
# ============================================================

rules/journal/*
!rules/journal/README.md
!rules/journal/cjyj.json
!rules/journal/cjyj.spec.html
!rules/journal/tjyj.json
!rules/journal/tjyj.spec.html
!rules/journal/gjjryj.json
!rules/journal/gjjryj.spec.html

# ============================================================
# Python
# ============================================================

__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
.pytest_cache/

# ============================================================
# 运行产物与本地文件
# ============================================================

*.log
logs/
*.tmp
*.bak
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.swp
